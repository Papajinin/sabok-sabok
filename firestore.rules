rules_version = '2';

// 사복사복: 허락한 구글 계정(엄마, 아빠)만 문제를 읽고, 각자 자기 풀이 기록만 읽고 쓸 수 있음
// 문제 올리기(tools/upload.html)는 아빠 계정만
// 고친 뒤에는 Firebase 관리 화면 → Firestore → 규칙에 붙여 넣고 "게시"
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAllowed() {
      return signedIn() && request.auth.token.email in [
        'loveygsa0215@gmail.com',  // 엄마
        'aristo0517@gmail.com'     // 아빠
      ];
    }
    function isDad() {
      return signedIn() && request.auth.token.email == 'aristo0517@gmail.com';
    }

    // 문제 (연도마다 문서 하나)
    match /exams/{year} {
      allow read: if isAllowed();
      allow write: if isDad();
    }

    // 풀이 기록 (사람마다 따로)
    match /users/{uid} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }
  }
}
